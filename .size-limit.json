[
  {
    "name": "main bundle (JS)",
    "path": "dist/assets/app-*.js",
    "limit": "180 KB",
    "gzip": true
  },
  {
    "name": "main bundle (CSS)",
    "path": "dist/assets/app-*.css",
    "limit": "12 KB",
    "gzip": true
  },
  {
    "name": "document shell chunk (JS+CSS)",
    "path": [
      "dist/assets/document-page-*.js",
      "dist/assets/document-page-*.css"
    ],
    "limit": "3 KB",
    "gzip": true
  },
  {
    "name": "resume view chunk (JS+CSS, carries its own copy)",
    "path": [
      "dist/assets/resume-*.js",
      "dist/assets/resume-*.css"
    ],
    "limit": "5 KB",
    "gzip": true
  },
  {
    "name": "privacy view chunk (JS+CSS, carries its own copy)",
    "path": [
      "dist/assets/privacy-*.js",
      "dist/assets/privacy-*.css"
    ],
    "limit": "3.5 KB",
    "gzip": true
  },
  {
    "name": "now-projects chunk (JS+CSS, carries the project descriptions)",
    "path": [
      "dist/assets/now-projects-section-*.js",
      "dist/assets/now-projects-section-*.css"
    ],
    "limit": "19.5 KB",
    "gzip": true
  },
  {
    "name": "modal chunk (JS+CSS)",
    "path": [
      "dist/assets/modal-*.js",
      "dist/assets/modal-*.css"
    ],
    "limit": "4 KB",
    "gzip": true
  },
  {
    "name": "image-viewer chunk (JS+CSS)",
    "path": [
      "dist/assets/image-viewer-*.js",
      "dist/assets/image-viewer-*.css"
    ],
    "limit": "3.5 KB",
    "gzip": true
  },
  {
    "name": "youtube-facade chunk (JS+CSS)",
    "path": [
      "dist/assets/youtube-facade-*.js",
      "dist/assets/youtube-facade-*.css"
    ],
    "limit": "5 KB",
    "gzip": true
  },
  {
    "name": "faq chunk (JS+CSS)",
    "path": [
      "dist/assets/faq-*.js",
      "dist/assets/faq-*.css"
    ],
    "limit": "3 KB",
    "gzip": true
  },
  {
    "name": "experience-brain chunk (JS+CSS)",
    "path": [
      "dist/assets/experience-brain-*.js",
      "dist/assets/experience-brain-*.css"
    ],
    "limit": "10 KB",
    "gzip": true
  },
  {
    "name": "blog index chunk",
    "path": [
      "dist/assets/blog-*.{js,css}",
      "!dist/assets/blog-post-*",
      "!dist/assets/blog-footer-*"
    ],
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "blog post chunk (JS+CSS: host styles for the TOC, charts, footnotes; the author line; the TOC comparison hook)",
    "path": "dist/assets/blog-post-*.{js,css}",
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "chart picture (turns a chart into a zoomable image; fetched on first tap)",
    "path": "dist/assets/chart-picture-*.js",
    "limit": "1 KB",
    "gzip": true
  },
  {
    "name": "blog footer chunk",
    "path": "dist/assets/blog-footer-*.{js,css}",
    "limit": "2.5 KB",
    "gzip": true
  },
  {
    "name": "toc lab (TEMPORARY: the table-of-contents comparison, ?toc-lab only; delete with it)",
    "path": [
      "dist/assets/toc-lab-*.js",
      "dist/assets/toc-lab-*.css"
    ],
    "limit": "3 KB",
    "gzip": true
  },
  {
    "name": "section rail (the chip, one async chunk)",
    "path": [
      "dist/assets/section-rail-*.js",
      "dist/assets/section-rail-*.css"
    ],
    "limit": "2.75 KB",
    "gzip": true
  }
]
